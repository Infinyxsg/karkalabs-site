{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/parent_dashboard/**",
              "ui_kits/website/**",
              "ui_kits/worksheet/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:poster|alt|tutor|caption|tone|showVoice|voiceOn|onToggleVoice|aspect|surface|children|key|ref|className|style|children)$/]",
        "message": "<BoardFrame> doesn't accept that prop. Declared props: poster, alt, tutor, caption, tone, showVoice, voiceOn, onToggleVoice, aspect, surface, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardFrame'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper)$/]",
        "message": "<BoardFrame> tone must be one of 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardFrame'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:scene|white)$/]",
        "message": "<BoardFrame> surface must be one of 'scene' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|tone|href|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, tone, href, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|chip)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<Button> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|ink)$/]",
        "message": "<Button> tone must be one of 'paper' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConceptState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|fg|titleFg|bg|border|dot|key|ref|className|style|children)$/]",
        "message": "<ConceptState> doesn't accept that prop. Declared props: label, fg, titleFg, bg, border, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|ink)$/]",
        "message": "<Eyebrow> tone must be one of 'paper' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|type|required|placeholder|name|autoComplete|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: id, label, type, required, placeholder, name, autoComplete."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeadForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:orgLabel|connected|onSubmit|key|ref|className|style|children)$/]",
        "message": "<LeadForm> doesn't accept that prop. Declared props: orgLabel, connected, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|key|ref|className|style|children)$/]",
        "message": "<StepProgress> doesn't accept that prop. Declared props: current, total."
      },
      {
        "selector": "JSXOpeningElement[name.name='TodoCopy'] > JSXAttribute > JSXIdentifier[name!=/^(?:what|owner|key|ref|className|style|children)$/]",
        "message": "<TodoCopy> doesn't accept that prop. Declared props: what, owner."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppCta'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|key|ref|className|style|children)$/]",
        "message": "<WhatsAppCta> doesn't accept that prop. Declared props: number."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
