{
  "name": "karkalabs-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketing site for karkalabs.ai — immersive sections are live Karka board embeds.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite-react-ssg build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build:fixture": "node scripts/build-fixture.mjs",
    "pretest": "npm run build:fixture",
    "test": "playwright test",
    "gate:screens": "playwright test --project=site tests/gate-launch.spec.ts",
    "gate:lighthouse": "node scripts/lighthouse.mjs",
    "gate:lighthouse:applied": "node -e \"process.env.LH_THROTTLING='devtools';import('./scripts/lighthouse.mjs')\"",
    "gate:side-by-side": "node scripts/side-by-side.mjs",
    "gate:lighthouse:trace": "node scripts/lighthouse-trace.mjs",
    "posters": "node scripts/make-posters.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "framer-motion": "^12.23.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "beasties": "^0.1.0",
    "chrome-launcher": "^1.2.0",
    "lighthouse": "^12.8.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vite-react-ssg": "^0.9.2"
  }
}
